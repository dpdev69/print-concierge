BAMBUDDY_BASE_URL=http://127.0.0.1:8080
BAMBUDDY_API_KEY=replace-with-a-least-privilege-token

# V0/V1 safety defaults.
PRINT_CONCIERGE_DIRECT_START_ENABLED=false
PRINT_CONCIERGE_REQUIRE_CONFIRMATION=true

# Optional JSON search backends. The response should include a `results` array
# with model fields such as id/title/url/license/profile/file.
# PRINT_CONCIERGE_MAKERWORLD_SEARCH_URL=https://search.example/makerworld?q={query}
# PRINT_CONCIERGE_PRINTABLES_SEARCH_URL=https://search.example/printables?q={query}
# PRINT_CONCIERGE_EXTERNAL_SEARCH_PROVIDERS=[{"name":"thangs","url":"https://search.example/thangs?q={query}","result_path":"items"}]

# Keep broad Bambuddy MCP/API credentials out of the same agent profile that runs
# Print Concierge. This companion should only expose curated, confirmation-gated
# print tools.
