BAMBUDDY_BASE_URL=http://127.0.0.1:8080
BAMBUDDY_API_KEY=replace-with-a-least-privilege-token

# V0/V1 safety defaults.
PRINT_CONCIERGE_DIRECT_START_ENABLED=false
PRINT_CONCIERGE_REQUIRE_CONFIRMATION=true

# Keep broad Bambuddy MCP/API credentials out of the same agent profile that runs
# Print Concierge. This companion should only expose curated, confirmation-gated
# print tools.
